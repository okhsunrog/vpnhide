# App -> core UDS. Core binds the socket inside the app's own data dir and copies the
# dir's label (app_data_file + the app's MLS categories) onto it, so the app's access to
# the socket inode is ordinary app-data access and needs no file rule here. The only grant
# is connecting to the root core process: its domain depends on the root manager
# (Magisk / APatch: magisk; KernelSU: ksu or su). A rule naming a type the host does not
# define is skipped by the manager. Core still fail-closes on SO_PEERCRED: root or the
# uid owning the app data dir only.
allow untrusted_app_all magisk unix_stream_socket { connectto };
allow untrusted_app_all ksu unix_stream_socket { connectto };
allow untrusted_app_all su unix_stream_socket { connectto };
