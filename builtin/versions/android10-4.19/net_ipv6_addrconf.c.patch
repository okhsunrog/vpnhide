diff --git a/net/ipv6/addrconf.c b/net/ipv6/addrconf.c
index 98b80d670..22d5ba0a0 100644
--- a/net/ipv6/addrconf.c
+++ b/net/ipv6/addrconf.c
@@ -78,6 +78,7 @@
 #include <net/ndisc.h>
 #include <net/ip6_route.h>
 #include <net/addrconf.h>
+#include <linux/vpnhide.h>
 #include <net/tcp.h>
 #include <net/ip.h>
 #include <net/netlink.h>
@@ -4869,6 +4870,11 @@ static int inet6_fill_ifaddr(struct sk_buff *skb, struct inet6_ifaddr *ifa,
 	struct nlmsghdr  *nlh;
 	u32 preferred, valid;
 
+	if (ifa->idev && ifa->idev->dev &&
+	    vpnhide_should_hide_dev(ifa->idev->dev,
