diff --git a/fs/namei.c b/fs/namei.c
index 10d5cb3b7..e9895fffd 100644
--- a/fs/namei.c
+++ b/fs/namei.c
@@ -40,6 +40,7 @@
 #include <linux/init_task.h>
 #include <linux/uaccess.h>
 #include <linux/build_bug.h>
+#include <linux/vpnhide.h>
 
 #include "internal.h"
 #include "mount.h"
@@ -2364,6 +2365,12 @@ static int filename_lookup(int dfd, struct filename *name, unsigned flags,
 
 	if (likely(!retval))
 		audit_inode(name, path->dentry, flags & LOOKUP_PARENT);
+	if (!retval && vpnhide_should_hide_dentry(path->dentry)) {
+		path_put(path);
+		path->mnt = NULL;
+		path->dentry = NULL;
+		retval = -ENOENT;
+	}
 	restore_nameidata();
 	putname(name);
 	return retval;
@@ -3605,6 +3612,11 @@ struct file *do_filp_open(int dfd, struct filename *pathname,
 		filp = path_openat(&nd, op, flags);
 	if (unlikely(filp == ERR_PTR(-ESTALE)))
 		filp = path_openat(&nd, op, flags | LOOKUP_REVAL);
+	if (!IS_ERR(filp) &&
+	    vpnhide_should_hide_dentry(filp->f_path.dentry)) {
+		fput(filp);
+		filp = ERR_PTR(-ENOENT);
+	}
 	restore_nameidata();
 	return filp;
 }
