+#include <linux/vpnhide.h>
 #include <linux/netfilter.h>
 
 #include <linux/if_tun.h>
@@ -2058,6 +2059,8 @@ static int __sys_setsockopt(int fd, int level, int optname,
 	char *kernel_optval = NULL;
 	int err, fput_needed;
 	struct socket *sock;
+	union vpnhide_bind_snapshot vh_snap;
