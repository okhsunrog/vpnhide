# Kconfig fragment merged AFTER qemu.config, on top of gki_defconfig: the
# subsystems a `qemu-system-aarch64 -machine virt` test boot never reaches.
# gki_defconfig compiles them into the Image (they are not modules — `make
# Image` builds no obj-m), so every one of them is compile time we pay on every
# cold CI kernel build and image bake for code no test can execute.
#
# The split is deliberate: `qemu.config` is what QEMU *needs* in order to boot,
# this file is what the tests *do not need*. Keeping them apart means a boot
# regression and a build-time experiment are never the same diff.
#
# What the harness actually uses (kmod/test/run.sh, builtin/test/run.sh,
# kmod/test/run-kpm.sh, kmod/test/init.sh): virtio-net-pci, the PL011 console,
# an initramfs with proc/sysfs/devtmpfs, a dummy netdev, kprobes and module
# loading. No `-drive` is ever passed and nothing is mounted from a disk.
#
# WHAT MUST NEVER BE ADDED HERE
# -----------------------------
# Anything that moves a member of a structure the backends read. The KPM backend
# reads those offsets from the hardcoded per-version table in
# kmod/kpm/kver_offsets.h — it never sees a kernel header — so a shifted offset
# would make kpm-qemu fail, or worse, pass against a layout no device has. That
# rules out NETFILTER / NF_CONNTRACK (sk_buff._nfct), NET_SCHED
# (sk_buff.tc_index), BPF_SYSCALL (sock.sk_bpf_storage), SELinux and the LSM
# blobs (sock.sk_security, file, inode), cgroups, CFI_CLANG, KASAN_HW_TAGS,
# UBSAN, RANDOMIZE_BASE and ARM64_SW_TTBR0_PAN — all of which stay on, exactly
# as on a device.
#
# The rule is enforced, not documented: kmod/test/verify-trim-abi.sh builds the
# ABI probe (kmod/test/abi/) against the same tree with and without this
# fragment and diffs the pahole layouts of every structure the backends touch.
# Run it after editing this file; the image bake runs it too.
#
# LTO is not touched here for the same reason it is not pinned in qemu.config:
# it is inherited per KMI from gki_defconfig, and on 5.10 it is what CFI needs.
#
# WHY USB, DRM, MEDIA AND SOUND ARE NOT HERE
# ------------------------------------------
# They are the four biggest built-in driver trees (about 300 objects on 6.1),
# and every one of them is held up by GKI_HACKS_TO_FIX — the dummy option that
# `select`s a GKI_HIDDEN_* helper per subsystem so out-of-tree vendor modules
# still find their symbols. With it on, `# CONFIG_MEDIA_SUPPORT is not set` is
# ignored outright (the symbol is selected), and switching off DRM, SOUND or
# USB_SUPPORT leaves kconfig in an unmet-dependency state no shipped kernel is
# ever configured in (SND_JACK=y with SND=n).
#
# Turning the master switch off is what does not work, and it took the ABI
# check to see why: on arm64 6.12, `select ARCH_HAS_DMA_OPS if (XEN ||
# GKI_HACKS_TO_FIX)` means GKI_HACKS_TO_FIX is what puts `dma_ops` in `struct
# device` — dropping it shrinks that structure by 8 bytes and shifts the whole
# tail of `struct net_device`, which embeds it. Several of the symbols it
# selects are structural in their own right too (PAGE_POOL and NET_DEVLINK via
# GKI_HIDDEN_NET_CONFIGS, WIRELESS_EXT via GKI_LEGACY_WEXT_ALLCONFIG,
# ARCH_WANTS_DYNAMIC_TASK_STRUCT via GKI_DYNAMIC_TASK_STRUCT_SIZE).
#
# So GKI's hidden configs are left alone, and the trim stops at what can be
# switched off without fighting them. If a future KMI stops routing DMA_OPS
# through GKI_HACKS_TO_FIX, this is the first thing to revisit — it is worth
# roughly another 11 % of the compile.

# --- debug info ------------------------------------------------------------
# Neither kprobes, nor KernelPatch, nor the harness reads DWARF or BTF. (BTF is
# already off in qemu.config, for a different reason: resolve_btfids fails on
# some GKI tips with the DDK container's pahole.) On 6.1+ DEBUG_INFO is a choice
# whose default is DWARF4; on 5.10 it is a plain bool, hence both spellings.
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y

# --- storage stacks --------------------------------------------------------
# virtio-blk stays enabled in qemu.config (it is part of the boot recipe), but
# nothing behind it does: no -drive is passed, so SCSI (and the USB mass-storage
# and UFS drivers that hang off it), MMC, NVMe, the device-mapper/RAID stack and
# the persistent-memory stack are dead weight.
# CONFIG_SCSI is not set
# CONFIG_MMC is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_MD is not set
# CONFIG_LIBNVDIMM is not set

# --- USB gadget ------------------------------------------------------------
# The USB host side stays (USB_SUPPORT is one of the trees GKI pins, see the
# header), but the gadget stack is the single biggest piece of it and nothing
# selects it — QEMU virt has no device-mode controller to drive.
# CONFIG_USB_GADGET is not set

# --- on-disk filesystems ---------------------------------------------------
# The rootfs is an initramfs (ramfs/tmpfs); proc, sysfs and devtmpfs come from
# qemu.config. Nothing mounts a real filesystem.
#
# fs/nls (52 objects) cannot follow them out: CONFIG_NLS is selected by
# CONFIG_USB ("for UTF-8 strings") and by PCI_LABEL, and both of those stay —
# USB because GKI pins it (see the header), PCI because virtio-pci is the test
# network device. Naming NLS here would be a line that does nothing.
# CONFIG_EXT4_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_EROFS_FS is not set
# CONFIG_FAT_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_EXFAT_FS is not set

# --- SoC plumbing with no QEMU virt counterpart ----------------------------
# Vendor clock controllers and the ARM SCMI/SCPI firmware transports are built
# in by gki_defconfig for real hardware. Two whole platforms go with them: the
# HiSilicon and Tegra clock drivers are pulled in by their SoC selections, so
# ARCH_HISI / ARCH_TEGRA are the switches that work (naming CLK_TEGRA_BPMP
# directly is overridden by the Tegra firmware driver that selects it).
# PSCI and EFI are deliberately NOT touched — `-machine virt` boots through
# them.
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_COMMON_CLK_SCPI is not set
# CONFIG_ARM_SCMI_PROTOCOL is not set
# CONFIG_ARM_SCPI_PROTOCOL is not set
# CONFIG_ARM_SCMI_CPUFREQ is not set
# CONFIG_ARM_SCPI_CPUFREQ is not set

# --- staging ---------------------------------------------------------------
# CONFIG_STAGING is not set
