+/* Ownership gate, not a spinlock: a control handler may fault on copy_to_user.
+ * Contenders report BUSY and can retry after the owning syscall returns.
+ */
+static unsigned int module_gate;
+
+static int try_module_gate(void)
+{
+    unsigned int expected = 0;
+    return __atomic_compare_exchange_n(&module_gate, &expected, 1, 0,
+                                       __ATOMIC_ACQUIRE, __ATOMIC_RELAXED);
+}
+
+static void release_module_gate(void)
+{
+    __atomic_store_n(&module_gate, 0, __ATOMIC_RELEASE);
+}

